  - language: ru
    title: "\u041F\u043B\u043E\u0449\u0430\u0434\u044C \u0420\u0435\u0433\u0438\u0441\u0442\u0430\u043D"
    text: "\u0420\u0435\u0433\u0438\u0441\u0442\u0430\u043D \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435
      \u043E\u0431\u0440\u0430\u0437\u0443\u044E\u0442 \u043C\u0435\u0434\u0440\u0435\u0441\u0435
      \u0423\u043B\u0443\u0433\u0431\u0435\u043A\u0430, \u0428\u0435\u0440-\u0414\u043E\u0440
      \u0438 \u0422\u0438\u043B\u043B\u044F-\u041A\u0430\u0440\u0438 XVII \u0432\u0435\u043A\u0430,
      \u0444\u0430\u0441\u0430\u0434\u044B \u043F\u043E\u043A\u0440\u044B\u0442\u044B
      \u043C\u0430\u0439\u043E\u043B\u0438\u043A\u043E\u0439 \u0438 \u0437\u0432\u0451\u0437\u0434\u043D\u044B\u043C\u0438
      \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438
      \u043E\u0440\u043D\u0430\u043C\u0435\u043D\u0442\u0430\u043C\u0438."
  colorsTile: {fileID: 11400000, guid: 63f1377c90d84ec478676a869dc2a2c1, type: 2}
