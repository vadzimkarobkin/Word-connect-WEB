  - language: ru
    title: "\u0414\u043E\u043B\u0438\u043D\u0430 \u041B\u0443\u043D\u044B"
    text: "\u0414\u043E\u043B\u0438\u043D\u0430 \u041B\u0443\u043D\u044B \u0432 \u0410\u0442\u0430\u043A\u0430\u043C\u0435
      \u0441\u043B\u043E\u0436\u0435\u043D\u0430 \u0441\u043E\u043B\u044F\u043D\u044B\u043C\u0438
      \u0433\u0440\u044F\u0434\u0430\u043C\u0438 \u0438 \u0434\u044E\u043D\u0430\u043C\u0438,
      \u0435\u0451 \u0431\u0435\u0437\u0432\u043E\u0434\u043D\u044B\u0435 \u043F\u0435\u0439\u0437\u0430\u0436\u0438
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442 \u0434\u043B\u044F
      \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439 \u0438
      \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0439 \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F
      \u043C\u0430\u0440\u0441\u0438\u0430\u043D\u0441\u043A\u0438\u0445 \u043C\u0438\u0441\u0441\u0438\u0439."
