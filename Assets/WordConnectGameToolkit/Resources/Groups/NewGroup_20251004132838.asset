  - language: ru
    title: "\u041A\u0430\u043F\u0438\u0442\u043E\u043B\u0438\u0439"
    text: "\u041A\u0430\u043F\u0438\u0442\u043E\u043B\u0438\u0439 \u0421\u0428\u0410
      \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0447\u0443\u0433\u0443\u043D\u043D\u044B\u0439
      \u043A\u0443\u043F\u043E\u043B \u0432 1866 \u0433\u043E\u0434\u0443, \u0435\u0433\u043E
      \u0432\u0435\u043D\u0447\u0430\u0435\u0442 \u0441\u0442\u0430\u0442\u0443\u044F
      \u0421\u0432\u043E\u0431\u043E\u0434\u044B \u0432\u044B\u0441\u043E\u0442\u043E\u0439
      \u043E\u043A\u043E\u043B\u043E 5,9 \u043C, \u0432\u043D\u0443\u0442\u0440\u0438
      \u0437\u0430\u0441\u0435\u0434\u0430\u044E\u0442 \u043E\u0431\u0435 \u043F\u0430\u043B\u0430\u0442\u044B
      \u041A\u043E\u043D\u0433\u0440\u0435\u0441\u0441\u0430."
  colorsTile: {fileID: 11400000, guid: d129003572c2d4b159bffaa89a976492, type: 2}
