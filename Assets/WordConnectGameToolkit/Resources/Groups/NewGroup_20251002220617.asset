    title: "\u0413\u043E\u0440\u044B \u0427\u0436\u0430\u043D\u0446\u0437\u044F\u0446\u0437\u0435"
    text: "\u041A \u0422\u044F\u043D\u044C\u043C\u044D\u043D\u044C\u0448\u0430\u043D\u044C
      \u0432 \u043E\u043A\u0440\u0443\u0433\u0435 \u0427\u0436\u0430\u043D\u0446\u0437\u044F\u0446\u0437\u0435
