      \u0434\u043E\u0440\u043E\u0433\u0430 \u0434\u043B\u0438\u043D\u043E\u0439 7,455
      \u043C; \u0440\u044F\u0434\u043E\u043C \u0441\u0435\u0440\u043F\u0430\u043D\u0442\u0438\u043D
      \xAB\u0414\u043E\u0440\u043E\u0433\u0430 \u043A \u043D\u0435\u0431\u0443\xBB
      \u0434\u0435\u043B\u0430\u0435\u0442 99 \u0440\u0435\u0437\u043A\u0438\u0445
      \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043E\u0432."
