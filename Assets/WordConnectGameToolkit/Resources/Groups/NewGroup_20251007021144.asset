      \u0417\u0430\u043B\u044C\u0446\u0431\u0443\u0440\u0433\u043E\u043C \u0441 XI
      \u0432\u0435\u043A\u0430. \u041A \u043D\u0435\u0439 \u0432\u0435\u0434\u0451\u0442
      \u0444\u0443\u043D\u0438\u043A\u0443\u043B\u0451\u0440 Festungsbahn, \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0439
