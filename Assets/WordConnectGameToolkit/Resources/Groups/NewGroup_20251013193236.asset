    title: "\u0421\u043E\u0431\u043E\u0440\u0430 \u0421\u0432\u044F\u0442\u043E\u0433\u043E
      \u041F\u0430\u0432\u043B\u0430"
    text: "\u0421\u043E\u0431\u043E\u0440 \u0421\u0432\u044F\u0442\u043E\u0433\u043E
      \u041F\u0430\u0432\u043B\u0430 \u0432 \u041B\u043E\u043D\u0434\u043E\u043D\u0435
      \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u043B \u041A\u0440\u0438\u0441\u0442\u043E\u0444\u0435\u0440
      \u0420\u0435\u043D \u043F\u043E\u0441\u043B\u0435 \u0412\u0435\u043B\u0438\u043A\u043E\u0433\u043E
      \u043F\u043E\u0436\u0430\u0440\u0430, \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u0430\u044F
      \u0413\u0430\u043B\u0435\u0440\u0435\u044F \u0448\u0451\u043F\u043E\u0442\u0430
      \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u043F\u043E\u0434 \u043A\u0443\u043F\u043E\u043B\u043E\u043C
      \u043D\u0430 \u0432\u044B\u0441\u043E\u0442\u0435"
