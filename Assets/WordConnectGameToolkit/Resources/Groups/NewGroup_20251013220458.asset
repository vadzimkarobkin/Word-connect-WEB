    title: "\u0421\u043E\u0431\u043E\u0440 \u0421\u0432\u044F\u0442\u043E\u0439 \u0421\u043E\u0444\u0438\u0438"
    text: "\u0421\u043E\u0431\u043E\u0440 \u0421\u0432\u044F\u0442\u043E\u0439 \u0421\u043E\u0444\u0438\u0438
      \u0432 \u0421\u0442\u0430\u043C\u0431\u0443\u043B\u0435 \u0441\u043E\u0447\u0435\u0442\u0430\u0435\u0442
      \u0432\u0438\u0437\u0430\u043D\u0442\u0438\u0439\u0441\u043A\u0438\u0439 \u043A\u0443\u043F\u043E\u043B
      VI \u0432\u0435\u043A\u0430 \u0438 \u043E\u0441\u043C\u0430\u043D\u0441\u043A\u0438\u0435
      \u043C\u0438\u043D\u0430\u0440\u0435\u0442\u044B, \u043C\u043E\u0437\u0430\u0438\u043A\u0438
      \u0441 \u043E\u0431\u0440\u0430\u0437\u0430\u043C\u0438 \u0434\u043E\u043B\u0433\u043E
      \u0441\u043A\u0440\u044B\u0432\u0430\u043B\u0438 \u043F\u043E\u0434 \u0448\u0442\u0443\u043A\u0430\u0442\u0443\u0440\u043A\u043E\u0439"
