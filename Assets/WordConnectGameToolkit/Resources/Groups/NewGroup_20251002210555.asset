    text: "\u0421\u043E\u0431\u043E\u0440 \u0412\u0430\u0441\u0438\u043B\u0438\u044F
      \u0411\u043B\u0430\u0436\u0435\u043D\u043D\u043E\u0433\u043E \u0432 \u041C\u043E\u0441\u043A\u0432\u0435
