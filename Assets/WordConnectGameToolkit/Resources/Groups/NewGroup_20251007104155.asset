  - language: ru
    title: "\u0410\u0442\u043E\u043C\u0438\u0443\u043C"
    text: "\u0410\u0442\u043E\u043C\u0438\u0443\u043C \u0432 \u0411\u0440\u044E\u0441\u0441\u0435\u043B\u0435
      \u0441\u043E\u0437\u0434\u0430\u043D \u043A \u042D\u041A\u0421\u041F\u041E-58
      \u0438 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u0442 \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B
      \u0436\u0435\u043B\u0435\u0437\u0430, \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u043D\u044B\u0439
      \u0432 \u043C\u0438\u043B\u043B\u0438\u0430\u0440\u0434\u044B \u0440\u0430\u0437.
      \u0412\u043D\u0443\u0442\u0440\u0438 \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u044B
      \u0432\u044B\u0441\u0442\u0430\u0432\u043A\u0438 \u0438 \u043E\u0431\u0437\u043E\u0440\u043D\u0430\u044F
      \u0437\u043E\u043D\u0430."
  colorsTile: {fileID: 11400000, guid: e8a60425bb67f42618a943883b553d29, type: 2}
