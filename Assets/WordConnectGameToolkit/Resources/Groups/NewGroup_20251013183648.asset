    text: "\u041A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u0438\u0439 \u0434\u0432\u043E\u0440\u0435\u0446
      \u0432 \u041C\u0430\u0434\u0440\u0438\u0434\u0435 \u043D\u0430\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442
      \u0441\u0432\u044B\u0448\u0435 \u0442\u0440\u0451\u0445 \u0442\u044B\u0441\u044F\u0447
      \u043A\u043E\u043C\u043D\u0430\u0442 \u0438 \u0445\u0440\u0430\u043D\u0438\u0442
      \u0421\u0442\u0440\u0430\u0434\u0438\u0432\u0430\u0440\u0438, \u043E\u0440\u0443\u0436\u0435\u0439\u043D\u0443\u044E
      \u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u044E \u0438 \u0448\u043F\u0430\u043B\u0435\u0440\u044B
      \u0413\u043E\u0439\u0438 \u0438 \u041C\u0435\u043D\u0433\u0441\u0430"
