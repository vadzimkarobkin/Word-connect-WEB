    text: "\u0412\u0435\u043B\u0438\u043A\u0438\u0439 \u0411\u0443\u0434\u0434\u0430
      \u041A\u0430\u043C\u0430\u043A\u0443\u0440\u044B \u0441\u0442\u043E\u0438\u0442
      \u043F\u043E\u0434 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C \u043D\u0435\u0431\u043E\u043C
      \u0441 XV \u0432\u0435\u043A\u0430 \u043F\u043E\u0441\u043B\u0435 \u0446\u0443\u043D\u0430\u043C\u0438
      1498 \u0433\u043E\u0434\u0430, \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u0430\u044F
      \u0441\u0442\u0430\u0442\u0443\u044F \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
      \u0432 \u0445\u0440\u0430\u043C\u0435 \u041A\u043E\u0442\u043E\u043A\u0443-\u0438\u043D."
