  - language: ru
    title: "\u0422\u0440\u0438\u043D\u0438\u0442\u0430-\u0434\u0435\u0438-\u041C\u043E\u043D\u0442\u0438"
    text: "\u0422\u0440\u0438\u043D\u0438\u0442\u0430 \u0434\u0435\u0438 \u041C\u043E\u043D\u0442\u0438
      \u0432\u0435\u043D\u0447\u0430\u0435\u0442 \u0418\u0441\u043F\u0430\u043D\u0441\u043A\u0443\u044E
      \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u0443, \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441
      \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0438\u0442 \u0424\u0440\u0430\u043D\u0446\u0438\u0438
      \u0438 \u0445\u0440\u0430\u043D\u0438\u0442 \u0444\u0440\u0435\u0441\u043A\u0438
      \u0414\u0430\u043D\u043D\u0438\u0435\u043B\u0435 \u0434\u0430 \u0412\u043E\u043B\u044C\u0442\u0435\u0440\u0440\u044B
      \u0438 \u043F\u043E\u0437\u0434\u043D\u0438\u0435 \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u0438\u044F"
