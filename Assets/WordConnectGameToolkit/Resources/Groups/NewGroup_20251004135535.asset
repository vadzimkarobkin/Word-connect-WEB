    title: "\u0421\u043E\u0431\u043E\u0440 \u0421\u0430\u043D\u0442\u0430-\u041C\u0430\u0440\u0438\u044F"
    text: "\u0421\u043E\u0431\u043E\u0440 \u0421\u0430\u043D\u0442\u0430-\u041C\u0430\u0440\u0438\u044F-\u0434\u0435\u043B\u044C-\u0424\u044C\u043E\u0440\u0435
      \u0432\u043E \u0424\u043B\u043E\u0440\u0435\u043D\u0446\u0438\u0438 \u0438\u043C\u0435\u0435\u0442
      \u043A\u0443\u043F\u043E\u043B \u0411\u0440\u0443\u043D\u0435\u043B\u043B\u0435\u0441\u043A\u0438,
      \u0432\u043E\u0437\u0432\u0435\u0434\u0451\u043D\u043D\u044B\u0439 \u0431\u0435\u0437
      \u043B\u0435\u0441\u043E\u0432 \u0432 XV \u0432\u0435\u043A\u0435, \u0435\u0433\u043E
      \u0432\u044B\u0441\u043E\u0442\u0430 \u0441 \u043B\u0430\u043D\u0442\u0435\u0440\u043D\u043E\u0439
      \u043E\u043A\u043E\u043B\u043E 114 \u043C."
