    text: "\u0412\u0435\u0441\u0442\u043C\u0438\u043D\u0441\u0442\u0435\u0440\u0441\u043A\u043E\u0435
      \u0430\u0431\u0431\u0430\u0442\u0441\u0442\u0432\u043E \u043A\u043E\u0440\u043E\u043D\u0443\u0435\u0442
      \u0431\u0440\u0438\u0442\u0430\u043D\u0441\u043A\u0438\u0445 \u043C\u043E\u043D\u0430\u0440\u0445\u043E\u0432
      \u0441 1066 \u0433\u043E\u0434\u0430 \u0438 \u0445\u0440\u0430\u043D\u0438\u0442
      \u041A\u043E\u0440\u043E\u043D\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0435
      \u043A\u0440\u0435\u0441\u043B\u043E, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u043D\u043E\u0435
      \u043D\u0430 \u0438\u043D\u0442\u0440\u043E\u043D\u0438\u0437\u0430\u0446\u0438\u044F\u0445
      \u0432\u0435\u043A\u043E\u0432."
