  - language: ru
    title: "\u0421\u0444\u0438\u043D\u043A\u0441"
    text: "\u0411\u043E\u043B\u044C\u0448\u043E\u0439 \u0421\u0444\u0438\u043D\u043A\u0441
      \u0432 \u0413\u0438\u0437\u0435 \u0432\u044B\u0440\u0435\u0437\u0430\u043D
      \u0438\u0437 \u0446\u0435\u043B\u044C\u043D\u043E\u0439 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044F\u043A\u043E\u0432\u043E\u0439
      \u0441\u043A\u0430\u043B\u044B \u0432 \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435
      III \u0442\u044B\u0441\u044F\u0447\u0435\u043B\u0435\u0442\u0438\u044F \u0434\u043E
      \u043D. \u044D., \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
      \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0441\u044C \u0441\u043B\u0435\u0434\u044B
      \u0434\u0440\u0435\u0432\u043D\u0435\u0439 \u043E\u043A\u0440\u0430\u0441\u043A\u0438."
  colorsTile: {fileID: 11400000, guid: 530ee400bda75ad44bcc4067e5f57ab8, type: 2}
