    title: "\u0414\u043E\u043B\u0438\u043D\u0430 \u043C\u043E\u043D\u0443\u043C\u0435\u043D\u0442\u043E\u0432"
    text: "\u0414\u043E\u043B\u0438\u043D\u0430 \u043C\u043E\u043D\u0443\u043C\u0435\u043D\u0442\u043E\u0432
      \u043B\u0435\u0436\u0438\u0442 \u043D\u0430 \u0437\u0435\u043C\u043B\u044F\u0445
      \u043D\u0430\u0432\u0430\u0445\u043E. \u041F\u0435\u0441\u0447\u0430\u043D\u0438\u043A\u043E\u0432\u044B\u0435
      \u043E\u0441\u0442\u0430\u043D\u0446\u044B \u0434\u043E 300 \u043C \u0441\u0442\u0430\u043B\u0438
      \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442\u044B\u043C \u0444\u043E\u043D\u043E\u043C
      \u0432 \u0432\u0435\u0441\u0442\u0435\u0440\u043D\u0430\u0445 \u0414\u0436\u043E\u043D\u0430
      \u0424\u043E\u0440\u0434\u0430."
