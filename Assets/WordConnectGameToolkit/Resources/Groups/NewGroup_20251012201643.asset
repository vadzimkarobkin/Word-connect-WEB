  - language: ru
    title: "\u042D\u0440\u043C\u0438\u0442\u0430\u0436"
    text: "\u042D\u0440\u043C\u0438\u0442\u0430\u0436 \u0432\u044B\u0440\u043E\u0441
      \u0438\u0437 \u0441\u043E\u0431\u0440\u0430\u043D\u0438\u044F, \u043D\u0430\u0447\u0430\u0442\u043E\u0433\u043E
      \u0415\u043A\u0430\u0442\u0435\u0440\u0438\u043D\u043E\u0439 II \u0432 1764
      \u0433\u043E\u0434\u0443 \u2014 \u043F\u0435\u0440\u0432\u044B\u0435 \u043A\u0430\u0440\u0442\u0438\u043D\u044B
      \u043A\u0443\u043F\u043B\u0435\u043D\u044B \u0443 \u0431\u0435\u0440\u043B\u0438\u043D\u0441\u043A\u043E\u0433\u043E
      \u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u043E\u043D\u0435\u0440\u0430
      \u0418. \u0413\u043E\u0446\u043A\u043E\u0432\u0441\u043A\u043E\u0433\u043E."
  colorsTile: {fileID: 11400000, guid: e8a60425bb67f42618a943883b553d29, type: 2}
