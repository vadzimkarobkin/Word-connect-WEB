  - language: ru
    title: "\u0410\u043D\u0433\u043A\u043E\u0440-\u0412\u0430\u0442"
    text: "\u0410\u043D\u0433\u043A\u043E\u0440-\u0412\u0430\u0442 \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0442
      \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u044B\u043C\u0438 \u0431\u0430\u0440\u0435\u043B\u044C\u0435\u0444\u0430\u043C\u0438
      \u0433\u0430\u043B\u0435\u0440\u0435\u0439 \u0434\u043B\u0438\u043D\u043E\u0439
      \u043A\u0438\u043B\u043E\u043C\u0435\u0442\u0440\u044B, \u0433\u0434\u0435
      \u0441\u0446\u0435\u043D\u044B \xAB\u0420\u0430\u043C\u0430\u044F\u043D\u044B\xBB
      \u0438 \xAB\u041C\u0430\u0445\u0430\u0431\u0445\u0430\u0440\u0430\u0442\u044B\xBB
      \u0447\u0438\u0442\u0430\u044E\u0442\u0441\u044F \u043A\u0430\u043A \u043A\u0430\u043C\u0435\u043D\u043D\u0430\u044F
      \u043B\u0435\u0442\u043E\u043F\u0438\u0441\u044C."
  colorsTile: {fileID: 11400000, guid: d129003572c2d4b159bffaa89a976492, type: 2}
