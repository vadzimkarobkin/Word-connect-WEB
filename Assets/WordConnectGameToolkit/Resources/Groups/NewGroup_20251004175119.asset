  - language: ru
    title: "\u0420\u0443\u0441\u0430\u043B\u043E\u0447\u043A\u0430"
    text: "\u041A\u043E\u043F\u0435\u043D\u0433\u0430\u0433\u0435\u043D\u0441\u043A\u0430\u044F
      \u0420\u0443\u0441\u0430\u043B\u043E\u0447\u043A\u0430 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0430
      \u0432 1913 \u0433\u043E\u0434\u0443 \u0441\u043A\u0443\u043B\u044C\u043F\u0442\u043E\u0440\u043E\u043C
      \u042D\u0434\u0432\u0430\u0440\u0434\u043E\u043C \u042D\u0440\u0438\u043A\u0441\u0435\u043D\u043E\u043C,
      \u0432\u0434\u043E\u0445\u043D\u043E\u0432\u043B\u0435\u043D\u0430 \u0441\u043A\u0430\u0437\u043A\u043E\u0439
      \u0410\u043D\u0434\u0435\u0440\u0441\u0435\u043D\u0430, \u0441\u0442\u0430\u0442\u0443\u044F
      \u043E\u0442\u043B\u0438\u0442\u0430 \u0438\u0437 \u0431\u0440\u043E\u043D\u0437\u044B."
  colorsTile: {fileID: 11400000, guid: c196518ac79cb9e40a9cbf03edcae82e, type: 2}
